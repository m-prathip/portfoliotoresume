<div class="resume" data-template="software-developer-fresher">
  <header class="header">
    <h1 class="name">{{personal.full_name}}</h1>
    {{#if personal.target_role}}<p class="target-role">{{personal.target_role}}</p>{{/if}}
    <p class="contact-line">
      {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
      {{#if personal.github}}<span>{{personal.github}}</span>{{/if}}
      {{#if personal.linkedin}}<span>{{personal.linkedin}}</span>{{/if}}
    </p>
  </header>

  {{#each sections}}
    {{#if (eq this "skills")}}
      {{#if ../skillGroups.length}}
      <section class="section">
        <h2>Skills</h2>
        {{#each ../skillGroups}}
        <div class="skill-row"><strong>{{this.category}}:</strong> {{this.items}}</div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "projects")}}
      {{#if ../projects.length}}
      <section class="section">
        <h2>Projects</h2>
        {{#each ../projects}}
        <div class="entry">
          <div class="entry-row">
            <strong>{{this.name}}</strong>
            {{#if this.github_url}}<span class="link">GitHub</span>{{/if}}
            {{#if this.live_url}}<span class="link">Live Demo</span>{{/if}}
          </div>
          {{#if this.solution}}<p class="entry-desc">{{this.solution}}</p>{{/if}}
          {{#if this.features.length}}<ul>{{#each this.features}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
          {{#if this.technologies.length}}<div class="entry-detail">Tech Stack: {{join this.technologies ", "}}</div>{{/if}}
          {{#if this.result}}<div class="entry-detail">{{this.result}}</div>{{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "internships")}}
      {{#if ../internships.length}}
      <section class="section">
        <h2>Internships</h2>
        {{#each ../internships}}
        <div class="entry">
          <div class="entry-row"><strong>{{this.role}}</strong><span class="dates">{{this.duration}}</span></div>
          <div class="entry-sub">{{this.company}}</div>
          <ul>{{#each this.responsibilities}}<li>{{this}}</li>{{/each}}</ul>
          {{#if this.technologies.length}}<div class="entry-detail">Tech: {{join this.technologies ", "}}</div>{{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "education")}}
      {{#if ../education.length}}
      <section class="section">
        <h2>Education</h2>
        {{#each ../education}}
        <div class="entry">
          <div class="entry-row"><strong>{{this.degree}}</strong><span class="dates">{{this.start_year}} – {{this.expected_graduation}}</span></div>
          <div class="entry-sub">{{this.college}}</div>
          {{#if this.cgpa_or_percentage}}<div class="entry-detail">CGPA: {{this.cgpa_or_percentage}}</div>{{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "certifications")}}
      {{#if ../certifications.length}}
      <section class="section">
        <h2>Certifications</h2>
        {{#each ../certifications}}
        <div class="entry-row">{{this.certificate}} — {{this.issuer}}{{#if this.date}} ({{this.date}}){{/if}}</div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "achievements")}}
      {{#if ../achievements.length}}
      <section class="section">
        <h2>Achievements</h2>
        <ul>{{#each ../achievements}}<li>{{this.title}}{{#if this.description}} — {{this.description}}{{/if}}</li>{{/each}}</ul>
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "activities")}}
      {{#if ../activities.length}}
      <section class="section">
        <h2>Leadership &amp; Activities</h2>
        {{#each ../activities}}
        <div class="entry-row">{{this.role}}, {{this.organization}}</div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
  {{/each}}
</div>
